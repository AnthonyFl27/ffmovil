# Copia este archivo a .env y completa los valores. Nunca subas .env al repositorio (RNF-06).

# API Key de VentasFF. Solo la lee el backend (RNF-01). Las pruebas no la usan:
# tests/conftest.py pone una clave ficticia.
VENTASFF_API_KEY=

# Opcional. URL base de VentasFF; en desarrollo puede apuntar al simulador:
#   uv run python -m tests.fake_ventasff --port 8099  →  http://127.0.0.1:8099/api/reseller
# VENTASFF_URL=https://ventasff.com/api/reseller

# PostgreSQL externo en el VPS (RNF-07).
# Formato: postgresql+psycopg://USUARIO:CLAVE@HOST:5432/NOMBRE_BD
# Las pruebas no la usan: tests/conftest.py la iguala a TEST_DATABASE_URL.
DATABASE_URL=

# Base para pruebas automáticas. Las pruebas solo usan el esquema `test` (RNF-10).
# Mismo formato que DATABASE_URL. Es la única variable de BD que necesitan las pruebas.
TEST_DATABASE_URL=

# Clave para firmar cookies de sesión y tokens CSRF. Genera una con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Atributo Secure de la cookie de sesión (RNF-11).
# false mientras la app corre por HTTP sin dominio; true en producción con HTTPS.
COOKIE_SECURE=

# Opcional (RNF-16). Cabecera con la IP real del cliente cuando la app va detrás de un proxy,
# p. ej. CF-Connecting-IP con el túnel de Cloudflare. Solo se acepta si la conexión viene de
# loopback o de una red privada; con el túnel, publica el puerto 8000 solo en 127.0.0.1.
# Sin esto, todos los clientes comparten IP y el tope por IP del login (RF-05) bloquea a todos.
# CLIENT_IP_HEADER=

# Opcional (RF-58, RF-59). Correo de contacto que se muestra en el pie de la página pública
# y en las páginas legales. Sin valor, la línea de contacto no se muestra.
# CONTACT_EMAIL=
